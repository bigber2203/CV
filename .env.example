# ==============================================================================
# PORTFOLIO ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Found in: Supabase Dashboard -> Project Settings -> API
# VITE_ prefixes are read by the Vite frontend (Admin Dashboard Auth & Reads)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Used by the Vercel backend serverless function (bypasses RLS to insert leads)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- EMAIL CONFIGURATION (RESEND) ---
# Found in: Resend Dashboard -> API Keys
# Used by Vercel backend to send notification emails
RESEND_API_KEY=re_your_api_key_here
